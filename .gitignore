# Maestro is now run from inside each driven repo: its config (maestro.yml) and
# runtime artifacts (worktrees, logs, runs.jsonl) live with the driven repo and
# in a sibling <repo>.maestro/ dir — never here. maestro.example.yml is the
# committed template. The lines below catch stale artifacts from the old layout.
maestro.yml
*.maestro/
logs/
worktrees/
runs.jsonl
*.log

# Per-session scratch — cc-session-save writes bookmarks under tmp/sessions/
tmp/

# macOS
.DS_Store
